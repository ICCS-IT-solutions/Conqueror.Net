<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ====================================================================
         Windows XP "Luna" palette. These are the actual system colours used
         by the Luna theme, so the shell reads as authentic XP Explorer.

         Kept in a ResourceDictionary (not Styles.Resources) so that views can
         reach them through Application.Resources with StaticResource.
         ==================================================================== -->

    <Color x:Key="LunaFace">#ECE9D8</Color>
    <Color x:Key="LunaLight">#FFFFFF</Color>
    <Color x:Key="LunaShadow">#ACA899</Color>
    <Color x:Key="LunaDarkShadow">#716F64</Color>
    <Color x:Key="LunaHighlight">#316AC5</Color>
    <Color x:Key="LunaHighlightText">#FFFFFF</Color>
    <Color x:Key="WindowWhite">#FFFFFF</Color>
    <Color x:Key="LunaInfo">#FFFFE1</Color>
    <Color x:Key="LunaTitleActive1">#0A246A</Color>
    <Color x:Key="LunaTitleActive2">#A6CAF0</Color>
    <Color x:Key="LunaTitleInactive1">#808080</Color>
    <Color x:Key="LunaTitleInactive2">#B5B5B5</Color>

    <SolidColorBrush x:Key="BrushFace" Color="{StaticResource LunaFace}" />
    <SolidColorBrush x:Key="BrushWindow" Color="{StaticResource WindowWhite}" />
    <SolidColorBrush x:Key="BrushHighlight" Color="{StaticResource LunaHighlight}" />
    <SolidColorBrush x:Key="BrushHighlightText" Color="{StaticResource LunaHighlightText}" />
    <SolidColorBrush x:Key="BrushShadow" Color="{StaticResource LunaShadow}" />
    <SolidColorBrush x:Key="BrushDarkShadow" Color="{StaticResource LunaDarkShadow}" />

    <LinearGradientBrush x:Key="BrushToolbarGradient" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#FFFFFF" />
        <GradientStop Offset="1" Color="#ECEBE5" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BrushStatusGradient" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#FFFFFF" />
        <GradientStop Offset="1" Color="#ECEBE5" />
    </LinearGradientBrush>

    <!-- XP's UI font. Tahoma ships with every Windows install this will run on. -->
    <FontFamily x:Key="XpFontFamily">Tahoma, Segoe UI, DejaVu Sans, sans-serif</FontFamily>
    <x:Double x:Key="XpFontSize">11</x:Double>

    <Thickness x:Key="XpToolbarHeight">23</Thickness>

</ResourceDictionary>
