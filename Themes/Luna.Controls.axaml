<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ====================================================================
         XP "raised" button, used by the menu bar and the tab strip.
         ==================================================================== -->

    <Style Selector="Window">
        <Setter Property="FontFamily" Value="{StaticResource XpFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource XpFontSize}" />
        <Setter Property="Background" Value="{StaticResource BrushFace}" />
    </Style>

    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{StaticResource LunaInfo}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushShadow}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4,2" />
    </Style>

    <Style Selector="Button.xpButton">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushDarkShadow}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="3">
                    <Border x:Name="PART_Inner"
                            Margin="1"
                            BorderBrush="{StaticResource LunaLight}"
                            BorderThickness="1"
                            CornerRadius="2">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.xpButton:pointerover /template/ Border#PART_Root">
        <Setter Property="BorderBrush" Value="{StaticResource LunaHighlight}" />
    </Style>
    <Style Selector="Button.xpButton:pointerover /template/ Border#PART_Inner">
        <Setter Property="BorderBrush" Value="#DCE6F5" />
    </Style>
    <Style Selector="Button.xpButton:pressed /template/ Border#PART_Inner">
        <Setter Property="BorderBrush" Value="{StaticResource BrushShadow}" />
    </Style>
    <Style Selector="Button.xpButton:disabled">
        <Setter Property="Opacity" Value="0.5" />
    </Style>

    <!-- Icon-only toolbar button. Hovering shows XP's amber glow. -->
    <Style Selector="Button.xpToolbarButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="Width" Value="23" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="3">
                    <Border x:Name="PART_Inner"
                            Margin="1"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="2">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.xpToolbarButton:pointerover">
        <Setter Property="Background" Value="#FDE79B" />
        <Setter Property="BorderBrush" Value="#F5A300" />
    </Style>
    <Style Selector="Button.xpToolbarButton:pointerover /template/ Border#PART_Inner">
        <Setter Property="BorderBrush" Value="{StaticResource LunaLight}" />
    </Style>
    <Style Selector="Button.xpToolbarButton:pressed">
        <Setter Property="Background" Value="#F5A300" />
    </Style>
    <Style Selector="Button.xpToolbarButton:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>

    <!-- ====================================================================
         Large navigation buttons: the 32 px Luna Back / Forward / Up arrows with
         their labels beside them, as on the classic XP toolbar.

         These cannot reuse xpToolbarButton, which fixes Width and Height to a
         23x22 square sized for a 16 px icon. That clips both the 32 px artwork and
         the label, so they get their own metrics and their own template that honours
         the alignment properties.
         ==================================================================== -->

    <Style Selector="Button.xpToolbarButtonLarge">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <!-- Only horizontal padding: vertical padding here would push the 32 px icon
             out of the 44 px button. -->
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="MinWidth" Value="82" />
        <Setter Property="Height" Value="44" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="3">
                    <Border x:Name="PART_Inner"
                            Margin="1"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="2">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.xpToolbarButtonLarge:pointerover">
        <Setter Property="Background" Value="#FDE79B" />
        <Setter Property="BorderBrush" Value="#F5A300" />
    </Style>
    <Style Selector="Button.xpToolbarButtonLarge:pointerover /template/ Border#PART_Inner">
        <Setter Property="BorderBrush" Value="{StaticResource LunaLight}" />
    </Style>
    <Style Selector="Button.xpToolbarButtonLarge:pressed">
        <Setter Property="Background" Value="#F5A300" />
    </Style>
    <Style Selector="Button.xpToolbarButtonLarge:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>

    <!-- ====================================================================
         Task pane tabs and Common Tasks rows.

         The tabs are small square-cornered buttons in the style of an XP
         toolbar button rather than the rounded window tabs used in the main
         strip, because they sit inside a sunken pane.
         ==================================================================== -->

    <Style Selector="Border.xpPaneTabStrip">
        <Setter Property="Background" Value="#F4F2E8" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushShadow}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style Selector="RadioButton.xpPaneTab">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#4A4A44" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="7,3" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Root"
                        Background="{TemplateBinding Background}"
                        CornerRadius="2,2,0,0"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      Background="Transparent"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.xpPaneTab:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="#E8E4D4" />
    </Style>
    <Style Selector="RadioButton.xpPaneTab:checked /template/ Border#PART_Root">
        <Setter Property="Background" Value="#FFFFFF" />
    </Style>
    <Style Selector="RadioButton.xpPaneTab:checked">
        <Setter Property="Foreground" Value="#0A246A" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- Common Tasks rows read as links, the way Explorer's task links do:
         flat until hovered, then the usual amber highlight. -->
    <Style Selector="Button.xpTaskLink">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="3,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Root"
                        Background="{TemplateBinding Background}"
                        CornerRadius="2"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Stretch" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.xpTaskLink:pointerover /template/ Border#PART_Root">
        <Setter Property="Background" Value="#FDE79B" />
    </Style>

    <!-- ====================================================================
         Sunken text fields: the address bar and the search box.
         ==================================================================== -->

    <Style Selector="TextBox.xpField">
        <Setter Property="Background" Value="{StaticResource BrushWindow}" />
        <Setter Property="Foreground" Value="#000000" />
        <Setter Property="BorderBrush" Value="#7F9DB9" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="3,2" />
        <Setter Property="MinHeight" Value="21" />
    </Style>

    <!-- The Vista+ style toolbar search is a 16 px slot. It carries both classes, so
         it needs the extra .xpField in the selector to outrank xpField: a class
         selector has the same specificity as xpField, so a plain xpFieldCompact would
         lose on document order. Setting Height alone would also do nothing, because
         xpField's MinHeight of 21 coerces the result back up to 21. -->
    <Style Selector="TextBox.xpField.xpFieldCompact">
        <Setter Property="MinHeight" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Padding" Value="3,0" />
    </Style>
    <Style Selector="TextBox.xpField:focus">
        <Setter Property="BorderBrush" Value="{StaticResource LunaHighlight}" />
    </Style>

    <!-- ====================================================================
         Menu bar: File / Edit / View / Favorites / Help.
         ==================================================================== -->

    <Style Selector="Menu.xpMenuBar">
        <Setter Property="Background" Value="{StaticResource BrushFace}" />
        <Setter Property="Padding" Value="0,1" />
    </Style>
    <Style Selector="MenuItem.xpMenuItem">
        <Setter Property="Padding" Value="8,3" />
    </Style>

    <!-- ====================================================================
         Flat white surfaces and XP blue selection for item lists.
         ==================================================================== -->

    <Style Selector="ListBox.xpList">
        <Setter Property="Background" Value="{StaticResource BrushWindow}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushShadow}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="2,1" />
        <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="ListBoxItem:selected">
        <Setter Property="Background" Value="{StaticResource BrushHighlight}" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="TextBlock.Foreground" Value="{StaticResource BrushHighlightText}" />
    </Style>

    <!-- ====================================================================
         Surfaces: toolbar, status bar and the task pane.
         ==================================================================== -->

    <Style Selector="Border.xpToolbarSurface">
        <Setter Property="Background" Value="{StaticResource BrushToolbarGradient}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushShadow}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.xpStatusSurface">
        <Setter Property="Background" Value="{StaticResource BrushStatusGradient}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushShadow}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style Selector="Border.xpTaskPaneSurface">
        <Setter Property="Background" Value="{StaticResource BrushWindow}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushShadow}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>

    <!-- XP's 3D groove separator. -->
    <Style Selector="Border.xpGroove">
        <Setter Property="Height" Value="2" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushShadow}" />
        <Setter Property="BorderThickness" Value="0,1,0,1" />
    </Style>

    <!-- ====================================================================
         Folder pane: the +/- expander box, the section header and the
         pane's close button, as in the Explorer reference screenshots.
         ==================================================================== -->

    <!-- A small sunken square carrying a + or a -, drawn rather than taken
         from artwork so it stays crisp at 11px and follows the theme. -->
    <Style Selector="ToggleButton.xpExpander">
        <Setter Property="Width" Value="11" />
        <Setter Property="Height" Value="11" />
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#7A7A8C" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <Grid>
                        <!-- Horizontal stroke is always present: a minus when open. -->
                        <Rectangle Width="7" Height="1" Fill="#3A3A46" VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                        <!-- The vertical stroke is dropped when open, leaving the minus. -->
                        <Rectangle Width="1" Height="7" Fill="#3A3A46" VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ToggleButton.xpExpander:checked /template/ Rectangle:nth-child(2)">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="Button.xpSectionHeader">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.xpSectionHeader:pointerover">
        <Setter Property="Background" Value="#E4ECF9" />
    </Style>

    <Style Selector="Button.xpPaneClose">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.xpPaneClose:pointerover">
        <Setter Property="Background" Value="#C8D4EC" />
    </Style>

    <!-- ====================================================================
         Address bar: the "Address:" label that doubles as the path /
         breadcrumb toggle, and the breadcrumb segments it reveals.
         ==================================================================== -->

    <!-- The label is a real control rather than a caption, because clicking it is
         how XP switches the address bar between a path and breadcrumbs. -->
    <Style Selector="ToggleButton.xpAddressLabel">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="3,1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <!--
          The stock ToggleButton template paints a rounded accent fill on focus and on the
          checked state, which reads as a modern button rather than the flat caption XP draws.
          Replaced with a flat bordered label; the checked state is carried by the xpChecked
          pseudo-class below instead.
        -->
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <!-- Hover shows the same focus rectangle Windows draws on the address label. -->
    <Style Selector="ToggleButton.xpAddressLabel:pointerover">
        <Setter Property="BorderBrush" Value="#7F9DB9" />
        <Setter Property="Background" Value="#EFF5FC" />
    </Style>
    <!-- Checked, i.e. breadcrumbs are showing: a sunken tint rather than a filled pill. -->
    <Style Selector="ToggleButton.xpAddressLabel:checked">
        <Setter Property="BorderBrush" Value="#7F9DB9" />
        <Setter Property="Background" Value="#DCE6F4" />
    </Style>

    <!-- One breadcrumb segment. Flat until hovered, so a long path does not read
         as a row of buttons. -->
    <Style Selector="Button.xpBreadcrumb">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="3,1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <!-- Flat template, so a segment reads as text until it is hovered. -->
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.xpBreadcrumb:pointerover">
        <Setter Property="BorderBrush" Value="#7F9DB9" />
        <Setter Property="Background" Value="#EFF5FC" />
    </Style>

    <!-- Flat, bordered column captions for the details view. -->
    <Style Selector="Button.xpColumnHeader">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushShadow}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="Padding" Value="4,3" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.xpColumnHeader:pointerover">
        <Setter Property="Background" Value="#EFF5FC" />
    </Style>

</Styles>
