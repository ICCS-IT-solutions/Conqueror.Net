<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Conqueror.Net.WebBrowserUi.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="520"
             x:Class="Conqueror.Net.WebBrowserUi.Views.BrowserView"
             x:DataType="vm:BrowserTabViewModel">

    <Grid RowDefinitions="*,Auto">

        <!-- Chromium host. Each BrowserTabViewModel owns a dedicated WebView that is
             re-parented into this Border on attach: a single ContentControl reuses its
             visual across tabs, so declaring one <WebView> here shared a single HWND
             and forced every tab onto the same page. The VM's own engine instance is
             the single owner of navigation and zoom. -->
        <Border Grid.Row="0" Background="#FFFFFF" Name="BrowserHost" />

        <!-- Zoom / DevTools strip -->
        <Border Grid.Row="1" Classes="xpStatusSurface">
            <Grid ColumnDefinitions="*,Auto" Margin="4,2">
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <Button Classes="xpButton" Padding="5,1"
                            Command="{Binding ZoomOutCommand}" Content="-" />
                    <TextBlock VerticalAlignment="Center" MinWidth="38"
                               TextAlignment="Center"
                               Text="{Binding ZoomPercentage, StringFormat={}{0:0}%}" />
                    <Button Classes="xpButton" Padding="5,1"
                            Command="{Binding ZoomInCommand}" Content="+" />
                    <Button Classes="xpButton" Padding="5,1"
                            Command="{Binding ShowDeveloperToolsCommand}" Content="DevTools" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
