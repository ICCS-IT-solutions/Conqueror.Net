<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Conqueror.Net.WebBrowserUi.ViewModels"
             xmlns:webview="clr-namespace:WebViewControl;assembly=WebViewControl.Avalonia"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="520"
             x:Class="Conqueror.Net.WebBrowserUi.Views.BrowserView"
             x:DataType="vm:BrowserTabViewModel">

    <Grid RowDefinitions="*,Auto">

        <!-- Chromium. WebViewControl hosts a real child HWND, so it must be given a
             concrete size by its parent layout rather than being left to stretch.

             Address is deliberately NOT bound here. Binding it would start navigation
             while the template is still being built, before BrowserView.Loaded has
             attached the view-model's event handlers, and the load callbacks would be
             missed (leaving the tab stuck on its placeholder title). BrowserTabViewModel
             drives navigation in Attach() instead, so it stays the single owner. -->
        <Border Grid.Row="0" Background="#FFFFFF">
            <webview:WebView Name="Browser"
                             Focusable="True"
                             AllowDeveloperTools="True" />
        </Border>

        <!-- Zoom / DevTools strip -->
        <Border Grid.Row="1" Classes="xpStatusSurface">
            <Grid ColumnDefinitions="*,Auto" Margin="4,2">
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <Button Classes="xpButton" Padding="5,1"
                            Command="{Binding ZoomOutCommand}" Content="-" />
                    <TextBlock VerticalAlignment="Center" MinWidth="38"
                               TextAlignment="Center"
                               Text="{Binding ZoomPercentage, StringFormat={}{0:0}%}" />
                    <Button Classes="xpButton" Padding="5,1"
                            Command="{Binding ZoomInCommand}" Content="+" />
                    <Button Classes="xpButton" Padding="5,1"
                            Command="{Binding ShowDeveloperToolsCommand}" Content="DevTools" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
