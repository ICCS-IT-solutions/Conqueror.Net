<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Conqueror.Net.WebBrowserUi.ViewModels"
        x:Class="Conqueror.Net.WebBrowserUi.Views.UserAgentDialog"
        x:DataType="vm:UserAgentDialogViewModel"
        Title="Configure User Agent"
        Width="550"
        Height="380"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="User Agent Configuration"
                   FontSize="20"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10" />

        <TextBlock Grid.Row="1"
                   Text="Select a preset or enter a custom User-Agent string for OAuth 2.0 compatibility with Google and Microsoft Entra ID."
                   TextWrapping="Wrap"
                   Margin="0,0,0,15"
                   Foreground="Gray" />

        <StackPanel Grid.Row="2" Orientation="Vertical" Spacing="8">
            <TextBlock Text="Preset:" FontWeight="SemiBold" Margin="0,0,0,5" />
            <ComboBox ItemsSource="{Binding Presets}"
                      SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                      DisplayMemberBinding="{Binding Name}"
                      HorizontalAlignment="Stretch"
                      Height="36" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Vertical" Spacing="8" Margin="0,10,0,0">
            <TextBlock Text="User Agent String:" FontWeight="SemiBold" Margin="0,0,0,5" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" Height="120">
                <TextBox Text="{Binding UserAgent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         FontFamily="Consolas, Monospace"
                         FontSize="12" />
            </ScrollViewer>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,15,0,0">
            <Button Content="Cancel"
                    Width="100"
                    Height="34"
                    Click="Cancel_Click" />
            <Button Content="OK"
                    Width="100"
                    Height="34"
                    Classes="Accent"
                    Click="Ok_Click" />
        </StackPanel>
    </Grid>
</Window>