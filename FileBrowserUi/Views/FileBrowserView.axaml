<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Conqueror.Net.FileBrowserUi.ViewModels"
             xmlns:models="clr-namespace:Conqueror.Net.FileBrowserUi.Models"
             xmlns:conv="clr-namespace:Conqueror.Net.WindowRoot.ViewModels"
             xmlns:icons="clr-namespace:Conqueror.Net.FileBrowserUi.Icons"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Avalonia.Svg.Skia"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="520"
             x:Class="Conqueror.Net.FileBrowserUi.Views.FileBrowserView"
             x:DataType="vm:FileBrowserViewModel">

    <!-- The four Explorer folder-pane layouts. The view swaps these at runtime.
         They live in Resources (key-addressable) rather than DataTemplates, which is a
         plain collection and cannot be looked up by name from code. -->
    <UserControl.Resources>
        <ResourceDictionary>
        <DataTemplate x:Key="EntryIconsTemplate" DataType="models:FileSystemEntry">
            <StackPanel Spacing="3" HorizontalAlignment="Center" Width="96">
                <!-- Panel holds both so they occupy one slot: XpIconKey is null for most entries
                     and the converter then draws nothing, leaving the SVG underneath visible. -->
                <Panel Width="32" Height="32">
                    <svg:Svg Path="{Binding IconKey, Converter={x:Static icons:IconKeyToUriConverter.Instance}}" EnableCache="True" Stretch="Uniform" Width="32" Height="32" />
                    <Image Source="{Binding XpIconKey, Converter={x:Static conv:IconKeyToXpImageConverter.Instance}, ConverterParameter=32}"
                           Stretch="Uniform" Width="32" Height="32" />
                </Panel>
                <TextBlock Text="{Binding Name}"
                           FontSize="11"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxHeight="40"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="EntryListTemplate" DataType="models:FileSystemEntry">
            <StackPanel Orientation="Horizontal" Spacing="4" Width="200">
                <Panel Width="18" Height="18">
                    <svg:Svg Path="{Binding IconKey, Converter={x:Static icons:IconKeyToUriConverter.Instance}}" EnableCache="True" Stretch="Uniform" Width="18" Height="18" />
                    <Image Source="{Binding XpIconKey, Converter={x:Static conv:IconKeyToXpImageConverter.Instance}, ConverterParameter=16}"
                           Stretch="Uniform" Width="18" Height="18" />
                </Panel>
                <TextBlock Text="{Binding Name}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="EntryDetailsTemplate" DataType="models:FileSystemEntry">
            <Grid ColumnDefinitions="*,110,150,140" Width="700">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                    <Panel Width="18" Height="18">
                        <svg:Svg Path="{Binding IconKey, Converter={x:Static icons:IconKeyToUriConverter.Instance}}" EnableCache="True" Stretch="Uniform" Width="18" Height="18" />
                        <Image Source="{Binding XpIconKey, Converter={x:Static conv:IconKeyToXpImageConverter.Instance}, ConverterParameter=16}"
                               Stretch="Uniform" Width="18" Height="18" />
                    </Panel>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding SizeDisplay}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding TypeDescription}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="3" Text="{Binding ModifiedDisplay}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="EntryTilesTemplate" DataType="models:FileSystemEntry">
            <Grid ColumnDefinitions="Auto,*" Margin="2" Width="460">
                <!-- The raster pack has no 48 px artwork, so the 32 px file is scaled up rather
                     than left blank; the vector theme has nothing this size-specific to lose. -->
                <Panel Width="48" Height="48" VerticalAlignment="Center">
                    <svg:Svg Path="{Binding IconKey, Converter={x:Static icons:IconKeyToUriConverter.Instance}}" EnableCache="True" Stretch="Uniform" Width="48" Height="48" />
                    <Image Source="{Binding XpIconKey, Converter={x:Static conv:IconKeyToXpImageConverter.Instance}, ConverterParameter=32}"
                           Stretch="Uniform" Width="48" Height="48" />
                </Panel>
                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding TypeDescription}" FontSize="10" Foreground="#555" />
                    <TextBlock Text="{Binding SizeDisplay}" FontSize="10" Foreground="#555" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{StaticResource BrushFace}">
        <!--
            Right-click menu for the pane. It hangs off the root border rather than the
            list so the folder tree and the empty margins are covered too; the DataContext
            it inherits is this pane's view-model, which is what makes the same markup work
            unchanged for a single-pane tab and for either side of a dual-pane (split) tab.
            Selection-dependent verbs grey out through SelectedItem, since commands act on
            SelectedItem plus the multi-selection.
        -->
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="_Open" Classes="xpMenuItem"
                          Command="{Binding OpenSelectedCommand}"
                          IsEnabled="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <!--
                    XP shows Edit alongside Open for anything Notepad-ish; here it means
                    "in-process editor", greyed unless the selection is one file the
                    editor's extension set covers (folders and binaries excluded).
                -->
                <MenuItem Header="_Edit" Classes="xpMenuItem"
                          Command="{Binding EditSelectedCommand}"
                          IsEnabled="{Binding CanEditSelected}" />
                <Separator />
                <MenuItem Header="New _File" Classes="xpMenuItem"
                          Command="{Binding NewFileCommand}" />
                <MenuItem Header="New F_older" Classes="xpMenuItem"
                          Command="{Binding NewFolderCommand}" />
                <Separator />
                <MenuItem Header="_Cut" Classes="xpMenuItem"
                          Command="{Binding CutCommand}" InputGesture="Ctrl+X"
                          IsEnabled="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <MenuItem Header="_Copy" Classes="xpMenuItem"
                          Command="{Binding CopyCommand}" InputGesture="Ctrl+C"
                          IsEnabled="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <MenuItem Header="_Paste" Classes="xpMenuItem"
                          Command="{Binding PasteCommand}" InputGesture="Ctrl+V" />
                <Separator />
                <MenuItem Header="_Delete" Classes="xpMenuItem"
                          Command="{Binding DeleteCommand}" InputGesture="Delete"
                          IsEnabled="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <MenuItem Header="_Rename" Classes="xpMenuItem"
                          Command="{Binding RenameCommand}" InputGesture="F2"
                          IsEnabled="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <MenuItem Header="_Properties" Classes="xpMenuItem"
                          Command="{Binding ShowPropertiesCommand}" InputGesture="Alt+Return"
                          IsEnabled="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <Separator />
                <MenuItem Header="Select _All" Classes="xpMenuItem"
                          Command="{Binding SelectAllCommand}" InputGesture="Ctrl+A" />
                <MenuItem Header="_Refresh" Classes="xpMenuItem"
                          Command="{Binding RefreshCommand}" InputGesture="F5" />
            </ContextMenu>
        </Border.ContextMenu>
        <DockPanel LastChildFill="True">

            <!-- ============ Task pane: folders and drives (XP's left sidebar) ==== -->
            <Border DockPanel.Dock="Left"
                    Width="190"
                    Classes="xpTaskPaneSurface"
                    IsVisible="{Binding ShowFolderPane}">
                <DockPanel LastChildFill="True">

                    <!-- Tab strip. XP's task pane is not a tab strip, but the pane has to carry
                         three different things and the width is fixed; tabs keep all three
                         reachable without stealing horizontal space from the file list. -->
                    <Border DockPanel.Dock="Top" Classes="xpPaneTabStrip">
                        <ItemsControl ItemsSource="{Binding TaskPaneTabs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:TaskPaneTabItem">
                                    <!-- IsChecked is one-way: the radio group owns the check mark,
                                         and the click is reported through the command instead.
                                         Two-way here would fight the group and leave two tabs
                                         looking selected. -->
                                    <RadioButton GroupName="TaskPaneTabs"
                                                 Classes="xpPaneTab"
                                                 Content="{Binding Name}"
                                                 IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                 Command="{Binding $parent[ItemsControl].((vm:FileBrowserViewModel)DataContext).SelectTaskPaneTabCommand}"
                                                 CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- ============================ Folders tab ============================ -->
                    <Grid IsVisible="{Binding IsFoldersTabVisible}"
                    RowDefinitions="*,Auto">
                    <DockPanel Grid.Row="0" LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top"
                               Text="Folders"
                               Margin="8,7,6,5"
                               FontWeight="Bold"
                               Foreground="#0A246A" />
                    <Border DockPanel.Dock="Top" Classes="xpGroove" Margin="6,0" />

                    <!-- The folder tree. Children are enumerated on expand, so opening the
                         pane stays instant even with several drives present. -->
                    <TreeView Name="FolderTree"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="0"
                              ItemsSource="{Binding TreeRoots}"
                              SelectedItem="{Binding SelectedTreeNode, Mode=TwoWay}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <TreeView.Styles>
                            <!-- x:DataType pins these bindings to the node rather than the
                                 page view-model, which is what compiled bindings assume. -->
                            <Style Selector="TreeViewItem" x:DataType="models:FolderTreeNode">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            </Style>
                        </TreeView.Styles>
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate ItemsSource="{Binding Children}" DataType="models:FolderTreeNode">
                                <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,1">
                                    <!-- The +/- expander box from the screenshot. -->
                                    <ToggleButton Grid.Column="0" Classes="xpExpander"
                                                  IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                  IsVisible="{Binding CanExpand}"
                                                  Margin="0,0,4,0" />
                                    <svg:Svg Grid.Column="1" Path="{Binding IconKey, Converter={x:Static icons:IconKeyToUriConverter.Instance}}" EnableCache="True" Stretch="Uniform"
                                          Width="16" Height="16" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Name}"
                                               Margin="4,0,0,0"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding Path}" />
                                </Grid>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    </DockPanel>
                    <!-- The collapsible sections from the task-pane screenshot, docked under the tree. "Other Places" repeats the shell folders as plain links. -->
                    <!--Visual inconsistency noted: These appear to theright, not below and pinned/anchored-->
                    <StackPanel Grid.Row="1" Margin="0,3,0,0">
                        <ItemsControl ItemsSource="{Binding TaskPaneSections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:TaskPaneSection">
                                    <StackPanel Margin="0,0,0,4">
                                        <Button Classes="xpSectionHeader"
                                                HorizontalAlignment="Stretch"
                                                Command="{Binding $parent[ItemsControl].((vm:FileBrowserViewModel)DataContext).ToggleSectionCommand}"
                                                CommandParameter="{Binding}">
                                            <Grid ColumnDefinitions="Auto,*" Margin="6,2">
                                                <!-- Chevron points down when open, right when shut. -->
                                                <Path Grid.Column="0" Data="M0,0 L7,0 L3.5,5 Z"
                                                      Fill="#31498C"
                                                      VerticalAlignment="Center"
                                                      IsVisible="{Binding IsExpanded}" />
                                                <Path Grid.Column="0" Data="M0,0 L5,3.5 L0,7 Z"
                                                      Fill="#31498C"
                                                      VerticalAlignment="Center"
                                                      IsVisible="{Binding !IsExpanded}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Title}"
                                                           Margin="4,0,0,0"
                                                           VerticalAlignment="Center"
                                                           FontWeight="Bold"
                                                           Foreground="#0A246A"
                                                           FontSize="11" />
                                            </Grid>
                                        </Button>
                                        <Border Classes="xpGroove" Margin="6,0" />

                                        <ItemsControl ItemsSource="{Binding Items}"
                                                      IsVisible="{Binding IsExpanded}"
                                                      Margin="18,2,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="models:ShellFolder">
                                                    <Grid ColumnDefinitions="Auto,*" Margin="0,1">
                                                        <svg:Svg Path="{Binding IconKey, Converter={x:Static icons:IconKeyToUriConverter.Instance}}" EnableCache="True" Stretch="Uniform"
                                                              Width="16" Height="16"
                                                              VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1"
                                                                   Margin="4,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding Name}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip.Tip="{Binding Path}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    </Grid>

                    <!-- ============================= Search tab ============================= -->
                    <!-- The recursive walk moved off the Folders tab and onto its own, so the
                         tree keeps its expansion state while a search runs. -->
                    <Grid IsVisible="{Binding IsSearchTabVisible}">
                        <DockPanel LastChildFill="True" Margin="6,6">
                            <TextBlock DockPanel.Dock="Top"
                                       Text="Search"
                                       Margin="2,0,0,5"
                                       FontWeight="Bold"
                                       Foreground="#0A246A" />
                            <Border DockPanel.Dock="Top" Classes="xpGroove" Margin="0,0,0,6" />

                            <TextBox DockPanel.Dock="Top"
                                     Classes="xpField xpFieldCompact"
                                     Text="{Binding SearchText, Mode=TwoWay}"
                                     Watermark="Search all subfolders"
                                     Margin="0,0,0,4"
                                     VerticalContentAlignment="Center">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding StartSearchCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>

                            <!-- Go and Stop occupy the same slot, so the row does not change
                                 height when the walk starts. -->
                            <Button DockPanel.Dock="Top" Classes="xpButton"
                                    Padding="6,1" MinHeight="20"
                                    Margin="0,0,0,4"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding StartSearchCommand}"
                                    IsVisible="{Binding !IsSearching}"
                                    Content="Search" />
                            <Button DockPanel.Dock="Top" Classes="xpButton"
                                    Padding="6,1" MinHeight="20"
                                    Margin="0,0,0,4"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding CancelSearchCommand}"
                                    IsVisible="{Binding IsSearching}"
                                    Content="Stop searching..." />

                            <TextBlock DockPanel.Dock="Top"
                                       Margin="2,0,0,6"
                                       FontSize="10"
                                       Foreground="#555"
                                       TextWrapping="Wrap"
                                       Text="Searches this folder and everything below it, then shows the matches in the file list." />
                        </DockPanel>
                    </Grid>

                    <!-- =========================== Common Tasks tab ========================== -->
                    <Grid IsVisible="{Binding IsCommonTasksTabVisible}">
                        <DockPanel LastChildFill="True" Margin="6,6">
                            <TextBlock DockPanel.Dock="Top"
                                       Text="Common Tasks"
                                       Margin="2,0,0,5"
                                       FontWeight="Bold"
                                       Foreground="#0A246A" />
                            <Border DockPanel.Dock="Top" Classes="xpGroove" Margin="0,0,0,4" />

                            <ItemsControl ItemsSource="{Binding CommonTasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="models:TaskPaneTask">
                                        <!-- Tag carries the task so the view can invoke it; a
                                             Command would mean wrapping each existing command
                                             in another ICommand for no added behaviour. -->
                                        <Button Classes="xpTaskLink"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Click="OnTaskLinkClick"
                                                Tag="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <svg:Svg Path="{Binding IconKey, Converter={x:Static icons:IconKeyToUriConverter.Instance}}"
                                                        EnableCache="True" Stretch="Uniform"
                                                        Width="16" Height="16"
                                                        VerticalAlignment="Center" />
                                                <StackPanel Margin="5,0,0,0">
                                                    <TextBlock Text="{Binding Name}"
                                                               Foreground="#0A246A"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Description}"
                                                               FontSize="10"
                                                               Foreground="#555"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- ================================ Content =========================== -->
            <DockPanel>

                <!-- Inline rename editor (F2, or immediately after New File / New Folder).
                     Enter or focus loss commits; Escape cancels. -->
                <TextBox Name="RenameBox"
                         DockPanel.Dock="Top"
                         Margin="4,4,4,0"
                         IsVisible="{Binding RenamingEntry, Converter={x:Static ObjectConverters.IsNotNull}}"
                         Text="{Binding RenameText, Mode=TwoWay}"
                         KeyDown="OnRenameKeyDown"
                         LostFocus="OnRenameLostFocus" />

                <!-- Sortable column headers, shown only in Details view. -->
                <Border Name="DetailsHeader" DockPanel.Dock="Top" IsVisible="False"
                        Background="#FFFFFF"
                        BorderBrush="{StaticResource BrushShadow}"
                        BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,110,150,140" Width="700">
                        <Button Grid.Column="0" Classes="xpColumnHeader" Command="{Binding SortByCommand}"
                                CommandParameter="Name" Content="Name" HorizontalAlignment="Stretch" />
                        <Button Grid.Column="1" Classes="xpColumnHeader" Command="{Binding SortByCommand}"
                                CommandParameter="Size" Content="Size" HorizontalAlignment="Stretch" />
                        <Button Grid.Column="2" Classes="xpColumnHeader" Command="{Binding SortByCommand}"
                                CommandParameter="Type" Content="Type" HorizontalAlignment="Stretch" />
                        <Button Grid.Column="3" Classes="xpColumnHeader" Command="{Binding SortByCommand}"
                                CommandParameter="DateModified" Content="Date Modified" HorizontalAlignment="Stretch" />
                    </Grid>
                </Border>

                <ListBox Name="EntryList"
                         Classes="xpList"
                         BorderThickness="0"
                         ItemsSource="{Binding Items}"
                         ItemTemplate="{StaticResource EntryIconsTemplate}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         SelectionMode="Multiple"
                         DoubleTapped="OnEntryDoubleTapped"
                         PointerPressed="OnEntryPointerPressed"
                         KeyDown="OnEntryKeyDown"
                         Background="{StaticResource BrushWindow}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </DockPanel>
        </DockPanel>
    </Border>
</UserControl>
