<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Conqueror.Net.FileBrowserUi.ViewModels"
             xmlns:views="clr-namespace:Conqueror.Net.FileBrowserUi.Views"
             xmlns:conv="clr-namespace:Conqueror.Net.WindowRoot.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="520"
             x:Class="Conqueror.Net.FileBrowserUi.Views.SplitPaneView"
             x:DataType="vm:SplitPaneViewModel">

    <!--
        The orthodox (dual-pane) layout: two independent file browsers side by side with a
        splitter between them. Each pane keeps its own history and its own folder tree.

        The splitter position is bound to a fraction rather than a pixel width, so the ratio
        between the panes survives a window resize.
    -->
    <Grid Name="PaneGrid" ColumnDefinitions="*,Auto,*" Background="{StaticResource BrushFace}">

        <!--
            The splitter's own right-click menu: the dual-pane verbs that belong to the
            tab rather than to either pane. Pane content is covered by FileBrowserView's
            context menu, so this is what surfaces when the divider strip is clicked.
            InputGesture strings match the window's key handlers and are display hints,
            the same convention as the main menu.

            The transfer verbs grey themselves against the pane that sources them — a
            copy to the right can only be as good as the left pane's selection — and the
            focus verbs exist because the shared address bar follows ActivePane, not the
            pointer.
        -->
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="_Swap Panes" Classes="xpMenuItem"
                          Command="{Binding SwapPanesCommand}" InputGesture="Ctrl+U" />
                <Separator />
                <MenuItem Header="Focus _Left Pane" Classes="xpMenuItem"
                          Command="{Binding FocusPaneCommand}"
                          CommandParameter="{Binding LeftPane}" />
                <MenuItem Header="Focus _Right Pane" Classes="xpMenuItem"
                          Command="{Binding FocusPaneCommand}"
                          CommandParameter="{Binding RightPane}" />
                <Separator />
                <MenuItem Header="Copy to Right ►" Classes="xpMenuItem"
                          Command="{Binding CopyToRightCommand}"
                          IsEnabled="{Binding LeftPane.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <MenuItem Header="Move to Right ►" Classes="xpMenuItem"
                          Command="{Binding MoveToRightCommand}"
                          IsEnabled="{Binding LeftPane.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <MenuItem Header="◄ Copy to Left" Classes="xpMenuItem"
                          Command="{Binding CopyToLeftCommand}"
                          IsEnabled="{Binding RightPane.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <MenuItem Header="◄ Move to Left" Classes="xpMenuItem"
                          Command="{Binding MoveToLeftCommand}"
                          IsEnabled="{Binding RightPane.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <Separator />
                <MenuItem Header="Refresh _Pane" Classes="xpMenuItem"
                          Command="{Binding RefreshActiveCommand}" InputGesture="F5" />
            </ContextMenu>
        </Grid.ContextMenu>

        <views:FileBrowserView Grid.Column="0"
                              DataContext="{Binding LeftPane}" />

        <!-- The grip. XP draws it as a narrow raised bar with a three-line handle. -->
        <GridSplitter Grid.Column="1" Width="7" ResizeDirection="Columns"
                      Background="#D4D0C8" HorizontalAlignment="Stretch"
                      DragCompleted="OnSplitterDragCompleted">
            <GridSplitter.Template>
                <ControlTemplate>
                    <Border Background="#D4D0C8" BorderBrush="#808080" BorderThickness="1,0">
                        <Grid>
                            <Rectangle Width="2" Fill="#808080" HorizontalAlignment="Center" />
                            <Rectangle Width="2" Fill="#FFFFFF" HorizontalAlignment="Center"
                                       Margin="1,0,0,0" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <views:FileBrowserView Grid.Column="2"
                              DataContext="{Binding RightPane}" />
    </Grid>
</UserControl>