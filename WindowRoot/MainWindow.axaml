<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Conqueror.Net.WindowRoot.ViewModels"
        xmlns:tabs="clr-namespace:Conqueror.Net.Core.Tabs"
        xmlns:fileVm="clr-namespace:Conqueror.Net.FileBrowserUi.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="640"
        x:Class="Conqueror.Net.WindowRoot.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1024" Height="640"
        MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen">

        <!--Design-time datacontext for previews and ASXG:-->
        <Design.DataContext>
            <vm:MainWindowViewModel />
        </Design.DataContext>

    <DockPanel LastChildFill="True">

        <!-- ================= Menu bar: File / Edit / View / Favorites / Help ===== -->
        <Menu DockPanel.Dock="Top" Classes="xpMenuBar">
            <MenuItem Header="_File" Classes="xpMenuItem">
                <MenuItem Header="_New Web Tab" Click="OnNewWebTabClick" InputGesture="Ctrl+T" />
                <MenuItem Header="New _Folder" Click="OnNewFolderClick" />
                <MenuItem Header="New _Dual-Pane Tab" Click="OnNewSplitPaneTabClick"
                          InputGesture="Ctrl+P" />
                <Separator />
                <MenuItem Header="_Open..." Click="OnOpenLocationClick" InputGesture="Ctrl+O" />
                <MenuItem Header="Close _Tab" Command="{Binding CloseTabCommand}" InputGesture="Ctrl+W" />
                <Separator />
                <MenuItem Header="E_xit" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="_Edit" Classes="xpMenuItem">
                <!--Common edit actions-->
                <MenuItem Header="New _File" Command="{Binding NewFileCommand}"
                          IsEnabled="{Binding CanNewFile}" InputGesture="Ctrl+N" />
                <MenuItem Header="New F_older" Command="{Binding NewFolderCommand}"
                          IsEnabled="{Binding CanNewFolder}" />
                <Separator />
                <MenuItem Header="_Cut" Command="{Binding CutCommand}"
                          IsEnabled="{Binding CanCut}" InputGesture="Ctrl+X" />
                <MenuItem Header="_Copy" Command="{Binding CopyCommand}"
                          IsEnabled="{Binding CanCopy}" InputGesture="Ctrl+C" />
                <MenuItem Header="_Paste" Command="{Binding PasteCommand}"
                          IsEnabled="{Binding CanPaste}" InputGesture="Ctrl+V" />
                <Separator />
                <MenuItem Header="_Delete" Command="{Binding DeleteCommand}"
                          IsEnabled="{Binding CanDelete}" InputGesture="Delete" />
                <MenuItem Header="_Rename" Command="{Binding RenameCommand}"
                          IsEnabled="{Binding CanRename}" InputGesture="F2" />
                <MenuItem Header="_Properties" Command="{Binding PropertiesCommand}"
                          IsEnabled="{Binding CanProperties}" InputGesture="Alt+Return" />
                <MenuItem Header="Select _All" Command="{Binding SelectAllCommand}"
                          IsEnabled="{Binding CanSelectAll}" InputGesture="Ctrl+A" />
            </MenuItem>
            <MenuItem Header="_View" Classes="xpMenuItem">
                <MenuItem Header="_Folder Pane" Name="FolderPaneMenuItem"
                          ToggleType="CheckBox" IsChecked="True"
                          IsVisible="{Binding SelectedTab.IsFileBrowser}"
                          Click="OnToggleFolderPaneClick" />
                <MenuItem Header="_Show Hidden Files" Name="HiddenFilesMenuItem"
                          ToggleType="CheckBox" IsChecked="False"
                          IsVisible="{Binding SelectedTab.IsFileBrowser}"
                          Click="OnToggleHiddenClick" />
                <Separator />
                <MenuItem Header="T_humbnails" Click="OnViewModeClick" Tag="Tiles" />
                <MenuItem Header="_Tiles" Click="OnViewModeClick" Tag="Tiles" />
                <MenuItem Header="_Icons" Click="OnViewModeClick" Tag="Icons" />
                <MenuItem Header="_List" Click="OnViewModeClick" Tag="List" />
                <MenuItem Header="_Details" Click="OnViewModeClick" Tag="Details" />
                <Separator />
                <MenuItem Header="_Refresh" Command="{Binding RefreshCommand}" InputGesture="F5" />
            </MenuItem>
            <MenuItem Header="Fa_vorites" Classes="xpMenuItem">
                <MenuItem Header="Open _Location..." Click="OnOpenLocationClick" />
            </MenuItem>
            <!--
                Contextual menus. These appear only when the active tab is an orthodox
                dual-pane tab; on a single-pane or web tab they would have nothing to act on,
                so they are hidden rather than shown greyed out.
            -->
            <MenuItem Header="_Pane" Classes="xpMenuItem"
                      IsVisible="{Binding IsSplitPaneActive}">
                <MenuItem Header="_Swap Panes" Command="{Binding SwapPanesCommand}"
                          InputGesture="Ctrl+U" />
                <MenuItem Header="_Even Split" Command="{Binding ResetSplitCommand}" />
                <Separator />
                <MenuItem Header="Refresh _Left" Click="OnRefreshPaneClick" Tag="Left" />
                <MenuItem Header="Refresh _Right" Click="OnRefreshPaneClick" Tag="Right" />
            </MenuItem>
            <!--Browser menu-->
            <MenuItem Header="Web Browser" Classes="xpMenuItem"
                      IsVisible="{Binding IsWebBrowserActive}">
                <MenuItem Header="_New Web Tab" Click="OnNewWebTabClick"
                          InputGesture="Ctrl+T" />
                <Separator />
                <MenuItem Header="_Back" Command="{Binding GoBackCommand}"
                          IsEnabled="{Binding SelectedTab.CanGoBack, Mode=OneWay}"
                          InputGesture="Alt+Left" />
                <MenuItem Header="_Forward" Command="{Binding GoForwardCommand}"
                          IsEnabled="{Binding SelectedTab.CanGoForward, Mode=OneWay}"
                          InputGesture="Alt+Right" />
                <MenuItem Header="_Refresh" Command="{Binding RefreshCommand}" InputGesture="F5" />
                <MenuItem Header="_Stop" Command="{Binding StopCommand}" />
                <Separator />
                <MenuItem Header="_Zoom In" Command="{Binding ZoomInCommand}" InputGesture="Ctrl+OemPlus" />
                <MenuItem Header="_Zoom Out" Command="{Binding ZoomOutCommand}" InputGesture="Ctrl+OemMinus" />
                <MenuItem Header="_Zoom Reset" Command="{Binding ZoomResetCommand}" InputGesture="Ctrl+0" />
                <Separator />
                <MenuItem Header="_Show Developer Tools" Command="{Binding ShowDeveloperToolsCommand}" />
                <MenuItem Header="_Extensions" Command="{Binding ExtensionsCommand}" />
            </MenuItem>

            <MenuItem Header="_Terminal" Classes="xpMenuItem">
                <MenuItem Header="_New Terminal Tab" Click="OnNewTerminalTabClick"
                          InputGesture="Ctrl+OemTilde" />
                <Separator />
                <!-- Shell actions are meaningless on a page, so they follow the active tab. -->
                <MenuItem Header="_Restart Shell" Command="{Binding SelectedTab.Reload}"
                          IsVisible="{Binding IsTerminalActive}" />
            </MenuItem>
            <MenuItem Header="_Help" Classes="xpMenuItem">
                <MenuItem Header="_About Conqueror.Net" Click="OnAboutClick" />
            </MenuItem>
        </Menu>

        <!-- ============================ Toolbar ================================= -->
        <Border DockPanel.Dock="Top" Classes="xpToolbarSurface">
            <DockPanel Margin="2,3" LastChildFill="True" Height="48">
                <!--Terminal tab-->
                <Button DockPanel.Dock="Right" Classes="xpToolbarButton"
                        Command="{Binding AddTerminalTabCommand}"
                        ToolTip.Tip="New terminal tab (Ctrl+`)">
                    <Image Source="avares://Conqueror.Net/Assets/Icons/xp/xp-command-prompt16.png"
                           Stretch="Uniform" Width="16" Height="16" />
                </Button>
                <!--Web browser tab-->
                <Button DockPanel.Dock="Right" Classes="xpToolbarButton"
                        Command="{Binding AddWebTabCommand}"
                        ToolTip.Tip="New web tab (Ctrl+T)">
                    <Image Source="avares://Conqueror.Net/Assets/Icons/xp/xp-connection16.png"
                           Stretch="Uniform" Width="16" Height="16" />
                </Button>
                <!--File browser tab-->
                <Button DockPanel.Dock="Right" Classes="xpToolbarButton"
                        Command="{Binding AddFileTabCommand}"
                        ToolTip.Tip="New file tab">
                    <Image Source="avares://Conqueror.Net/Assets/Icons/xp/xp-explorer16.png"
                           Stretch="Uniform" Width="16" Height="16" />
                </Button>
                <Rectangle DockPanel.Dock="Right" Width="1" Margin="4,2,8,2"
                           Fill="{StaticResource BrushShadow}" />
                <Button DockPanel.Dock="Right" Classes="xpToolbarButton"
                        Command="{Binding RefreshCommand}"
                        ToolTip.Tip="Refresh (F5)">
                    <Image Source="avares://Conqueror.Net/Assets/Icons/xp/xp-refresh16.png"
                           Stretch="Uniform" Width="16" Height="16" />
                </Button>


                <!-- Search box lives on the toolbar, exactly as in Windows Vista+ Explorer.
                     xpFieldCompact keeps it at 16 px so it stays the same size as before
                     the toolbar grew to fit the 32 px navigation buttons.

                     The classes are space separated, not comma separated. Avalonia parses
                     Classes="a,b" as one class literally named "a,b", which silently fails
                     to match any selector; only whitespace separates them. -->
                <TextBox DockPanel.Dock="Right" Classes="xpField xpFieldCompact"
                         Width="150" Margin="4,0,6,0"
                         VerticalContentAlignment="Center"
                         Text="{Binding SelectedTab.SearchText, Mode=TwoWay}"
                         Watermark="Search" />

                <!-- Back / Forward / Up use the real Luna buttons at 32 px with their labels
                     beside them. xpToolbarButtonLarge replaces xpToolbarButton here, whose
                     fixed 23x22 box clips both the larger icon and the label. The icon column
                     is Auto rather than * so the label sits immediately beside the artwork. -->
                <Button DockPanel.Dock="Left" Classes="xpToolbarButtonLarge"
                        Command="{Binding GoBackCommand}"
                        IsEnabled="{Binding CanGoBack}"
                        ToolTip.Tip="Back (Alt+Left)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="avares://Conqueror.Net/Assets/Icons/xp/xp-back32.png"
                               Stretch="Uniform" Width="32" Height="32"
                               VerticalAlignment="Center" />
                        <TextBlock Text="Back" Margin="5,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Left" Classes="xpToolbarButtonLarge"
                        Command="{Binding GoForwardCommand}"
                        IsEnabled="{Binding CanGoForward}"
                        ToolTip.Tip="Forward (Alt+Right)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="avares://Conqueror.Net/Assets/Icons/xp/xp-forward32.png"
                               Stretch="Uniform" Width="32" Height="32"
                               VerticalAlignment="Center" />
                        <TextBlock Text="Forward" Margin="5,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Left" Classes="xpToolbarButtonLarge"
                        Command="{Binding GoUpCommand}"
                        IsEnabled="{Binding CanGoUp}"
                        ToolTip.Tip="Up one level (Alt+Up)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="avares://Conqueror.Net/Assets/Icons/xp/xp-up32.png"
                               Stretch="Uniform" Width="32" Height="32"
                               VerticalAlignment="Center" />
                        <TextBlock Text="Up" Margin="5,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <!--Separator between the navigation buttons and the edit actions. The separator is a 1 px rectangle with a Luna shadow brush, not a Border, so it does not add extra padding to the toolbar. -->
                <Border DockPanel.Dock="Left" Width="1" Background="{StaticResource BrushLunaShadow}" />
                <!--Show cut, copy, paste, delete and select all. These are available throughout the application -->
                <Button DockPanel.Dock="Left" Classes="xpToolbarButtonLarge"
                        Command="{Binding CutCommand}"
                        IsEnabled="{Binding CanCut}"
                        ToolTip.Tip="Cut (Ctrl+X)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="avares://Conqueror.Net/Assets/Icons/xp/xp-cut32.png"
                               Stretch="Uniform" Width="32" Height="32"
                               VerticalAlignment="Center" />
                        <TextBlock Text="Cut" Margin="5,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Left" Classes="xpToolbarButtonLarge"
                        Command="{Binding CopyCommand}"
                        IsEnabled="{Binding CanCopy}"
                        ToolTip.Tip="Copy (Ctrl+C)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="avares://Conqueror.Net/Assets/Icons/xp/xp-copy32.png"
                               Stretch="Uniform" Width="32" Height="32"
                               VerticalAlignment="Center" />
                        <TextBlock Text="Copy" Margin="5,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Left" Classes="xpToolbarButtonLarge"
                        Command="{Binding PasteCommand}"
                        IsEnabled="{Binding CanPaste}"
                        ToolTip.Tip="Paste (Ctrl+V)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="avares://Conqueror.Net/Assets/Icons/xp/xp-paste32.png"
                               Stretch="Uniform" Width="32" Height="32"
                               VerticalAlignment="Center" />
                        <TextBlock Text="Paste" Margin="5,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Left" Classes="xpToolbarButtonLarge"
                        Command="{Binding DeleteCommand}"
                        IsEnabled="{Binding CanDelete}"
                        ToolTip.Tip="Delete (Del)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="avares://Conqueror.Net/Assets/Icons/xp/xp-delete32.png"
                               Stretch="Uniform" Width="32" Height="32"
                               VerticalAlignment="Center" />
                        <TextBlock Text="Delete" Margin="5,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Left" Classes="xpToolbarButtonLarge"
                        Command="{Binding SelectAllCommand}"
                        IsEnabled="{Binding CanSelectAll}"
                        ToolTip.Tip="Select All (Ctrl+A)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="avares://Conqueror.Net/Assets/Icons/xp/xp-selectall32.png"
                               Stretch="Uniform" Width="32" Height="32"
                               VerticalAlignment="Center" />
                        <TextBlock Text="Select All" Margin="5,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <!--Separator here-->
                <Border DockPanel.Dock="Left" Width="1" Background="{StaticResource BrushLunaShadow}" />
                <!--New file, new folder, properties and rename are available only in file browser tabs, so they are hidden on web and terminal tabs.-->
                <Button DockPanel.Dock="Left" Classes="xpToolbarButtonLarge"
                        Command="{Binding NewFileCommand}"
                        IsEnabled="{Binding CanNewFile}"
                        IsVisible="{Binding SelectedTab.IsFileBrowser}"
                        ToolTip.Tip="New file (Ctrl+N)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="avares://Conqueror.Net/Assets/Icons/xp/xp-newfile32.png"
                               Stretch="Uniform" Width="32" Height="32"
                               VerticalAlignment="Center" />
                        <TextBlock Text="New File" Margin="5,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Left" Classes="xpToolbarButtonLarge"
                        Command="{Binding NewFolderCommand}"
                        IsEnabled="{Binding CanNewFolder}"
                        IsVisible="{Binding SelectedTab.IsFileBrowser}"
                        ToolTip.Tip="New folder">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="avares://Conqueror.Net/Assets/Icons/xp/xp-newfolder32.png"
                               Stretch="Uniform" Width="32" Height="32"
                               VerticalAlignment="Center" />
                        <TextBlock Text="New Folder" Margin="5,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Left" Classes="xpToolbarButtonLarge"
                        Command="{Binding RenameCommand}"
                        IsEnabled="{Binding CanRename}"
                        IsVisible="{Binding SelectedTab.IsFileBrowser}"
                        ToolTip.Tip="Rename (F2)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="avares://Conqueror.Net/Assets/Icons/xp/xp-rename32.png"
                               Stretch="Uniform" Width="32" Height="32"
                               VerticalAlignment="Center" />
                        <TextBlock Text="Rename" Margin="5,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Left" Classes="xpToolbarButtonLarge"
                        Command="{Binding PropertiesCommand}"
                        IsEnabled="{Binding CanProperties}"
                        IsVisible="{Binding SelectedTab.IsFileBrowser}"
                        ToolTip.Tip="Properties">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="avares://Conqueror.Net/Assets/Icons/xp/xp-properties32.png"
                               Stretch="Uniform" Width="32" Height="32"
                               VerticalAlignment="Center" />
                        <TextBlock Text="Properties" Margin="5,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>


            </DockPanel>
        </Border>

        <!-- ====================== Tab strip and address bar ==================== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BrushFace}">
            <DockPanel LastChildFill="True">

                <ItemsControl DockPanel.Dock="Top"
                              ItemsSource="{Binding Tabs}"
                              Margin="2,4,2,0"
                              Height="23">
                    <!-- Tabs are Buttons so the whole strip is keyboard reachable. The layout
                         follows Firefox 4: even, compact tabs sitting on the strip, the active
                         one raised and lit while the rest rest back. Colours come from the Luna
                         palette so the strip reads as XP chrome rather than a flat list. -->
                    <ItemsControl.Styles>
                        <Style Selector="ItemsControl > Button" x:DataType="tabs:ITabViewModel">
                            <Setter Property="Background" Value="{StaticResource BrushFace}" />
                            <Setter Property="BorderBrush" Value="{StaticResource BrushShadow}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,3,0" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <ControlTemplate>
                                    <!-- Two stacked borders: the outer keeps the tab's base colour
                                         and corner radius; the thin Luna-blue lip on top echoes the
                                         highlight Windows paints along an active tab's edge. -->
                                    <Border x:Name="TabSurface"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4,4,0,0">
                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                          Margin="0,2,0,0" />
                                    </Border>
                                </ControlTemplate>
                            </Setter>
                        </Style>

                        <!-- Inactive tabs rest back on the strip; hovering lifts them toward the
                             active colour, and pressing confirms the selection. -->
                        <Style Selector="ItemsControl > Button:pointerover /template/ Border#TabSurface">
                            <Setter Property="Background" Value="#F5F3EC" />
                        </Style>
                        <Style Selector="ItemsControl > Button:pressed /template/ Border#TabSurface">
                            <Setter Property="Background" Value="#EBE7DA" />
                        </Style>
                        <Style Selector="ItemsControl > Button.isActive /template/ Border#TabSurface">
                            <Setter Property="Background" Value="{StaticResource LunaLight}" />
                            <Setter Property="BorderBrush" Value="{StaticResource LunaHighlight}" />
                        </Style>
                    </ItemsControl.Styles>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="tabs:ITabViewModel">
                            <Button Classes="xpTab"
                                    Click="OnTabClick"
                                    CommandParameter="{Binding}">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <!-- Tab icon: 16 px XP artwork centred in a fixed cell so the
                                         titles line up whether or not a glyph resolves. -->
                                    <Image Grid.Column="0"
                                           Source="{Binding IconKey, Converter={x:Static vm:IconKeyToXpImageConverter.Instance}, ConverterParameter=16}"
                                           Stretch="Uniform"
                                           Width="16" Height="16"
                                           Margin="4,0,4,0"
                                           VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Title}"
                                               VerticalAlignment="Center"
                                               MaxWidth="150"
                                               TextTrimming="CharacterEllipsis" />
                                    <!-- The close button is a child of the tab button, so it
                                         deliberately keeps its own hit testing: it consumes
                                         the click and does not bubble up to select the tab. -->
                                    <Button Grid.Column="2" Classes="xpToolbarButton"
                                            Width="16" Height="16" Padding="0"
                                            Margin="0,0,2,0"
                                            VerticalAlignment="Center"
                                            Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).CloseTabCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="Close this tab">
                                        <Image Source="avares://Conqueror.Net/Assets/Icons/xp/xp-close16.png"
                                               Stretch="Uniform" Width="16" Height="16" />
                                    </Button>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid DockPanel.Dock="Top" Margin="3,5,3,3" ColumnDefinitions="Auto,*,Auto" Height="24">
                    <!-- The "Address:" label doubles as the mode toggle on a folder tab, which is
                     how XP reaches the breadcrumb view. On a web tab there is no breadcrumb
                     form of a URL, so it stays a plain caption. -->
                    <ToggleButton Grid.Column="0" Classes="xpAddressLabel"
                                  IsVisible="{Binding IsAddressLabelToggleable}"
                                  IsChecked="{Binding IsBreadcrumbModeVisible}"
                                  Command="{Binding ToggleAddressBarModeCommand}"
                                  Content="Address:">
                        <ToolTip.Tip>
                            <ToolTip>
                                <TextBlock Text="Click to switch between the folder path and breadcrumbs" />
                            </ToolTip>
                        </ToolTip.Tip>
                    </ToggleButton>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center"
                               Text="Address:" Margin="0,0,4,0"
                               IsVisible="{Binding !IsAddressLabelToggleable}" />

                    <!-- Path view: the editable box, which is the default. -->
                    <TextBox Grid.Column="1" Name="AddressBox" Classes="xpField"
                             IsVisible="{Binding IsPathModeVisible}"
                             Text="{Binding AddressText, Mode=TwoWay}"
                             VerticalContentAlignment="Center">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding NavigateCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>

                    <!-- Breadcrumb view: clickable segments joined by arrows. -->
                    <ItemsControl Grid.Column="1"
                                  IsVisible="{Binding IsBreadcrumbModeVisible}"
                                  ItemsSource="{Binding AddressBreadcrumbs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="fileVm:BreadcrumbSegment">
                                <StackPanel Orientation="Horizontal">
                                    <Button Classes="xpBreadcrumb"
                                            Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).NavigateToAddressBreadcrumbCommand}"
                                            CommandParameter="{Binding}"
                                            Content="{Binding Name}"
                                            ToolTip.Tip="{Binding Path}" />
                                    <!-- No arrow after the final segment, so the row does not
                                         trail a separator past the current folder. -->
                                    <TextBlock Text="→" Margin="3,0" VerticalAlignment="Center"
                                               Foreground="#5A5A5A"
                                               IsVisible="{Binding !IsLast}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--This replicates the windows XP explorer "Go" button exactly, and the word "Go" is visible by default--> 
                    <Button Grid.Column="2" Classes="xpButton" Margin="4,0,0,0"
                            IsVisible="{Binding IsPathModeVisible}"
                            Command="{Binding NavigateCommand}"
                            ToolTip.Tip="Go to this address (Enter)">
                        <Grid ColumnDefinitions="Auto,Auto" Margin="4,0,4,0">
                            <Image Grid.Column ="0" Source="avares://Conqueror.Net/Assets/Icons/xp/xp-go16.png"
                                Stretch="Uniform" Width="16" Height="16" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0"
                                Text="Go" />
                        </Grid>   
                    </Button>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ============================ Status bar ============================= -->
        <!-- Docked before the content control on purpose: with LastChildFill=True the
             final child is the one that fills, so the status bar must come first. -->
        <Border DockPanel.Dock="Bottom" Classes="xpStatusSurface">
            <Grid ColumnDefinitions="*,Auto" Margin="4,3">
                <TextBlock Grid.Column="0"
                           Text="{Binding ActiveStatusText}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1"
                           Text="My Computer"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           Foreground="#3A3A3A" />
            </Grid>
        </Border>

        <!-- ========================= Tab content area ========================== -->
        <ContentControl Content="{Binding SelectedTab}" />
    </DockPanel>
</Window>

