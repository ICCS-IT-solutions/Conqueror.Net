<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!--
      app.manifest carries the Windows version-compatibility GUIDs and means nothing elsewhere,
      so it is applied on Windows only rather than unconditionally.
    -->
    <ApplicationManifest Condition="$([MSBuild]::IsOSPlatform('Windows'))">app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!--
      PlatformTarget is deliberately not pinned to x64. Hard-coding it would break the arm64
      Linux and Apple-silicon macOS builds a cross-platform build has to include; the RID the
      SDK selects now decides the architecture.
    -->
        <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

  <!--
    NOTE 2026-10-06: the BuildAndCopyCustomBrowserProcess target has been
    removed. The custom Xilium.CefGlue.BrowserProcess.dll (SimpleCefApp wrapper)
    faulted inside libcef.execute_process at coreclr.dll+0x1d45dc on every
    renderer spawn, leaving tabs blank with DevTools disconnected; the stock
    CefGlue subprocess renders correctly. The CustomBrowserProcess/ sources are
    retained for reference but are no longer built or copied.
  -->

  <!-- SVG icon theme. Kept out of the default globs because Avalonia's XAML compiler
       would try to treat them as styles; they are plain assets consumed by
       Avalonia.Svg.Skia at runtime. See tools/import-icon-theme.ps1. -->
  <ItemGroup>
    <AvaloniaResource Include="Assets/Icons/*.svg" />
  </ItemGroup>

  <!--
       Raster XP chrome icons (tab strip, toolbar buttons). These must ship as PNGs because
       they are the real Windows XP artwork, which is photographic raster rather than vector -
       there is no vector equivalent of the Luna back/forward/go buttons. Produced by
       tools/import-xp-chrome-icons.ps1 from the CC0-1.0 Marchmountain pack.
  -->
  <ItemGroup>
    <AvaloniaResource Include="Assets/Icons/xp/*.png" />
  </ItemGroup>

  <!--
    Shell/ is a separate project whose obj/ directory sits underneath this one. The SDK's
    default **/*.cs glob would pull Shell/obj/**/Conqueror.Net.Shell.AssemblyInfo.cs into this
    project as well as Shell's own, producing duplicate assembly attributes (CS0579) whenever
    the solution is built. Excluding it here means the two projects can coexist in one tree.
  -->
    <ItemGroup>
    <Compile Remove="Shell/**" />
    <Compile Remove="CustomBrowserProcess/**" />
    <!--
      Also remove the nested project's Avalonia XAML. The XAML compiler otherwise picks up
      Shell/Views/*.axaml and fails with AXN0001, since those classes belong to the other
      assembly. AvaloniaXaml is the item type the SDK assigns to .axaml files; the others are
      removed for the same reason as above.
    -->
    <AvaloniaXaml Remove="Shell/**" />
    <AvaloniaResource Remove="Shell/**" />
    <None Remove="Shell/**" />
    <EmbeddedResource Remove="Shell/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Avalonia.Diagnostics" Version="11.3.22" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Embedded Chromium (CEF 120) browser control for Avalonia. -->
    <PackageReference Include="WebViewControl-Avalonia" Version="3.120.13" />
    <!-- Renders the SVG icon theme. MIT; targets net8.0 / Avalonia 11.3. -->
    <PackageReference Include="Avalonia.Svg.Skia" Version="11.3.0" />
    <!-- Content-based MIME detection, used to pick icons. The Condensed definition set is
         ~1 MB instead of the ~9 MB exhaustive one; both are enough to identify real files. -->
    <PackageReference Include="Mime-Detective" Version="25.8.1" />
    <PackageReference Include="Mime-Detective.Definitions.Condensed" Version="25.8.1" />
  </ItemGroup>
</Project>
