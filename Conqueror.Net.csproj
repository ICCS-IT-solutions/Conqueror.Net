<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <PlatformTarget>x64</PlatformTarget>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

  <!-- SVG icon theme. Kept out of the default globs because Avalonia's XAML compiler
       would try to treat them as styles; they are plain assets consumed by
       Avalonia.Svg.Skia at runtime. See tools/import-icon-theme.ps1. -->
  <ItemGroup>
    <AvaloniaResource Include="Assets/Icons/*.svg" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Avalonia.Diagnostics" Version="11.3.22" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Embedded Chromium (CEF 120) browser control for Avalonia. -->
    <PackageReference Include="WebViewControl-Avalonia" Version="3.120.13" />
    <!-- Renders the SVG icon theme. MIT; targets net8.0 / Avalonia 11.3. -->
    <PackageReference Include="Avalonia.Svg.Skia" Version="11.3.0" />
    <!-- Content-based MIME detection, used to pick icons. The Condensed definition set is
         ~1 MB instead of the ~9 MB exhaustive one; both are enough to identify real files. -->
    <PackageReference Include="Mime-Detective" Version="25.8.1" />
    <PackageReference Include="Mime-Detective.Definitions.Condensed" Version="25.8.1" />
  </ItemGroup>
</Project>
