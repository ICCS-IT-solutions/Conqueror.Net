{
    // Ordered by how often you will reach for them: build, run, watch, publish, format.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/Conqueror.Net.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "run",
            "command": "dotnet",
            "type": "process",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/Conqueror.Net.csproj"
            ],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/Conqueror.Net.csproj"
            ],
            "isBackground": true,
            "problemMatcher": "$msCompile"
        },
        {
            // The -r is required: CEF ships native binaries per RID, and the project
            // pins PlatformTarget=x64. Output lands in bin/Release/net8.0/win-x64/publish.
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/Conqueror.Net.csproj",
                "-c",
                "Release",
                "-r",
                "win-x64",
                "--self-contained",
                "false",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            // CSharpier. If this fails with "dotnet-csharpier does not exist", the global
            // tool shim is missing; see the Troubleshooting section of README.md.
            "label": "format",
            "command": "dotnet",
            "type": "process",
            "args": ["csharpier", "${workspaceFolder}"],
            "problemMatcher": []
        },
        {
            "label": "clean",
            "command": "dotnet",
            "type": "process",
            "args": [
                "clean",
                "${workspaceFolder}/Conqueror.Net.csproj"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}
