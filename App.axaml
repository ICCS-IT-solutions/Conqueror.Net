<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fileVm="clr-namespace:Conqueror.Net.FileBrowserUi.ViewModels"
             xmlns:fileViews="clr-namespace:Conqueror.Net.FileBrowserUi.Views"
             xmlns:webVm="clr-namespace:Conqueror.Net.WebBrowserUi.ViewModels"
             xmlns:webViews="clr-namespace:Conqueror.Net.WebBrowserUi.Views"
             xmlns:codeVm="clr-namespace:Conqueror.Net.CodeEditorUi.ViewModels"
             xmlns:codeViews="clr-namespace:Conqueror.Net.CodeEditorUi.Views"
             x:Class="Conqueror.Net.App"
             RequestedThemeVariant="Light">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Conqueror.Net/Themes/Palette.axaml" />
                <ResourceInclude Source="avares://Conqueror.Net/Themes/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <!-- Fluent supplies the un-themed control internals (scrollbars, menus, popups);
             the Luna stylesheet then repaints them in XP colours. -->
                <FluentTheme />
        <StyleInclude Source="avares://Conqueror.Net/Themes/Luna.Controls.axaml" />
        <!-- AvaloniaEdit styles: required for the in-process code/config editor's
             TextEditor control (syntax highlighting, line numbers, scrollbars). -->
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    </Application.Styles>

    <!-- Tab content is resolved from its view-model type, which is what lets the shell
         swap file tabs, Chromium tabs, dual-pane tabs and terminals through one
         ContentControl. -->
    <Application.DataTemplates>
        <DataTemplate DataType="fileVm:FileBrowserViewModel">
            <fileViews:FileBrowserView />
        </DataTemplate>
        <DataTemplate DataType="webVm:BrowserTabViewModel">
            <webViews:BrowserView />
        </DataTemplate>
        <DataTemplate DataType="fileVm:SplitPaneViewModel">
            <fileViews:SplitPaneView />
        </DataTemplate>
        <DataTemplate DataType="fileVm:TerminalViewModel">
            <fileViews:TerminalView />
        </DataTemplate>
        <DataTemplate DataType="codeVm:CodeEditorViewModel">
            <codeViews:CodeEditorView />
        </DataTemplate>
    </Application.DataTemplates>
</Application>
